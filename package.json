{
  "name": "caldav-to-ics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "flask-dev": "uv venv --quiet 2>/dev/null; uv pip install -r requirements.txt && FLASK_DEBUG=1 uv run python -m flask --app api/sync run -p 5328",
    "next-dev": "next dev",
    "dev": "concurrently \"pnpm run next-dev\" \"pnpm run flask-dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "concurrently": "^10.0.4",
    "@vercel/blob": "^2.6.1"
  },
  "packageManager": "pnpm@11.20.0"
}
