{
  "name": "caldav-to-ics",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "flask-dev": "uv venv --quiet 2>/dev/null; uv pip install -r requirements.txt && FLASK_DEBUG=1 uv run python -m flask --app api/sync run -p 5328",
    "next-dev": "next dev",
    "dev": "concurrently \"pnpm run next-dev\" \"pnpm run flask-dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "concurrently": "^10.0.6",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2"
  }
}
